[worldserver]

# Playerbot World PvP
# Simple autonomous hotspot events: attackers rally outside, move into town/zone target,
# defenders/responders spawn at the defense point, then the event fizzles out.

PlayerbotWorldPvp.Enable = 1
PlayerbotWorldPvp.Debug = 1

# How often the module rolls for a random world-PvP event.
PlayerbotWorldPvp.TickSeconds = 60
PlayerbotWorldPvp.EventChancePerTick = 20
PlayerbotWorldPvp.MaxActiveEvents = 2
PlayerbotWorldPvp.StartupDelaySeconds = 120

# Safety: only random Playerbot accounts should ever be moved.
# auto imports AiPlayerbot.RandomBotAccountPrefix, for your setup likely ashrandbot.
PlayerbotWorldPvp.BotOnlyEligibilityFilter = 1
PlayerbotWorldPvp.UsePlayerbotConfig = 1
PlayerbotWorldPvp.BotAccountPrefix = auto
PlayerbotWorldPvp.BotAccountMin = 0
PlayerbotWorldPvp.BotAccountMax = 0

# Movement model.
# Attackers teleport to rally/outside-town point, then MovePoint toward target.
# Set HardTeleportToTarget=1 only if bots refuse to move.
PlayerbotWorldPvp.TeleportBots = 1
PlayerbotWorldPvp.ReturnBotsAfterEvent = 1
PlayerbotWorldPvp.UseMovePointAfterRally = 1
PlayerbotWorldPvp.HardTeleportToTarget = 0
PlayerbotWorldPvp.MoveFromRallyDelaySeconds = 15
PlayerbotWorldPvp.PositionJitter = 8

# Candidate pool.
# GlobalMinLevel clamps every hotspot so lowbie bots do not get dragged into world PvP.
# For your current realm, keep this at 20 until the bot population catches up.
PlayerbotWorldPvp.GlobalMinLevel = 20
PlayerbotWorldPvp.BotQueryLimit = 600
PlayerbotWorldPvp.MinOnlineBotsRequired = 3
# Keep small at first because your current server has a thin 20+ population.
PlayerbotWorldPvp.MaxBotsPerSide = 8

# Audit log.
PlayerbotWorldPvp.FileLog = 1
PlayerbotWorldPvp.FileLogPath = Logs/playerbot_world_pvp.log

# Same-faction duel practice.
# Same-team hotspots, like StormwindDuel and OrgrimmarDuel, stage pairs and cast the Duel spell.
PlayerbotWorldPvp.SameFactionDuels = 1
PlayerbotWorldPvp.DuelRequestDelaySeconds = 8
PlayerbotWorldPvp.DuelSpellId = 7266
PlayerbotWorldPvp.DuelPairLimit = 8

# Playerbot AI integration.
# This is the important part from inspecting mod-playerbots: bots already have a "pvp" strategy
# that attacks enemy players when an enemy player is nearby, and a "duel" strategy that
# accepts/responds to duel requests. WPvP now forces those strategies during events.
PlayerbotWorldPvp.EnablePlayerbotAiStrategies = 1
PlayerbotWorldPvp.ForcePvpFlag = 1
PlayerbotWorldPvp.ForceAttackOnEngage = 1
PlayerbotWorldPvp.EngageAfterMoveSeconds = 4
PlayerbotWorldPvp.EngageRetrySeconds = 5
PlayerbotWorldPvp.EngageMaxRetries = 12
PlayerbotWorldPvp.PvpCombatStrategies = +pvp,+boost,+dps debuff,-passive,-stay
PlayerbotWorldPvp.PvpNonCombatStrategies = +pvp,+duel,+boost,-passive,-stay
